# =============================================================================
# LARAVEL CORE
# =============================================================================

# Environment files (contains secrets, DB credentials, API keys)
.env
.env.backup
.env.production
.env.staging
.env.local
.env.testing
.env.*.php
.env.php

# Composer dependencies (installed via composer install)
/vendor

# NPM dependencies (installed via npm ci)
/node_modules

# Laravel bootstrap cache (auto-generated)
/bootstrap/cache/*.php
/bootstrap/cache/packages.php
/bootstrap/cache/services.php
/bootstrap/cache/routes*.php

# Storage: logs, sessions, cache, uploads, compiled views
/storage/*.key
/storage/installed
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*.php
/storage/logs/*.log
/storage/logs/laravel.log
/storage/pail

# Frontend build artifacts (generated by npm run build)
/public/build
/public/hot
/public/mix-manifest.json
/public/css/app.css
/public/js/app.js

# =============================================================================
# TESTING
# =============================================================================
.phpunit.result.cache
.phpunit.cache
phpunit.xml
phpunit.xml.dist
coverage/

# =============================================================================
# IDE & EDITOR FILES 
# =============================================================================

/.vscode

# =============================================================================
# OS GENERATED FILES
# =============================================================================
.DS_Store
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
.Spotlight-V100
.Trashes
._*

# =============================================================================
# LOGS & TEMP FILES
# =============================================================================
*.log
npm-debug.log
yarn-error.log
nohup.out
*.bak
*.orig
*.tmp


